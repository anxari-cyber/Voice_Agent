# Copy to .env and change what you need. Every value below is the default.
VOICEAI_PROJECT_ROOT=
# Folder for downloaded models (can be on another drive, e.g. D:/voiceai/models)
VOICEAI_MODELS_DIR=models

# Microphone / speaker: name substring or index (see `voiceai --list-devices`).
# Leave empty to use the Windows default device.
VOICEAI_MIC_DEVICE=
VOICEAI_SPEAKER_DEVICE=

# LLM (local Ollama)
VOICEAI_LLM_URL=http://127.0.0.1:11434
VOICEAI_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
VOICEAI_LLM_NUM_CTX=4096
VOICEAI_LLM_MAX_TOKENS=200
VOICEAI_SYSTEM_PROMPT_FILE=config/system_prompt.md

# Speech-to-text: parakeet (default) or whisper (needs the [whisper] extra)
VOICEAI_STT_ENGINE=parakeet
VOICEAI_STT_MODEL=small.en
VOICEAI_STT_DEVICE=auto
VOICEAI_STT_COMPUTE_TYPE=auto

# Text-to-speech
VOICEAI_TTS_ENGINE=kokoro
VOICEAI_TTS_VOICE=af_heart
VOICEAI_TTS_DEVICE=cuda

# Voice activity detection and turn taking (milliseconds)
VOICEAI_VAD_THRESHOLD=0.5
VOICEAI_VAD_START_MS=64
VOICEAI_VAD_END_MS=200
VOICEAI_PRE_ROLL_MS=500
VOICEAI_JOIN_WINDOW_MS=700
VOICEAI_BARGEIN_MIN_MS=160
VOICEAI_SMART_TURN_THRESHOLD=0.5

VOICEAI_LATENCY_LOG=logs/latency.jsonl
