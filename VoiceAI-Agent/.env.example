VOICEAI_MODEL=gemini-3.8-flash
VOICEAI_GEMINI_API_KEY=
VOICEAI_GEMINI_TIMEOUT_MS=30000
VOICEAI_PROJECT_ROOT=
VOICEAI_STT_MODEL=small.en
VOICEAI_STT_DEVICE=auto
VOICEAI_STT_COMPUTE_TYPE=auto
# Microphone / speaker: name substring or index (see `voiceai --list-devices`).
# Leave empty to use the Windows default device.
VOICEAI_MIC_DEVICE=
VOICEAI_SPEAKER_DEVICE=
VOICEAI_LATENCY_LOG=logs/latency.jsonl
